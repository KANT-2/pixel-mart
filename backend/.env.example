# 복사해서 backend/.env 로 사용하세요 (.env는 Git에 올리지 않습니다)
ENV=local

# 로컬 PostgreSQL (설치형: 5432 / docker compose: 5433)
DATABASE_URL=postgresql+asyncpg://pixelmart:pixelmart@localhost:5432/pixelmart

# 로컬 전용 비밀값 — 아무 긴 문자열로 바꿔도 됩니다
JWT_SECRET=local-dev-secret-change-me-please-32chars

FRONTEND_URL=http://localhost:3000

# 구글 로그인 (Google Cloud Console에서 발급, 팀 채널로만 공유)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI 픽셀 아바타 — Cloudflare 값이 있으면 Cloudflare Workers AI(무료 일일 할당), 없으면 Gemini.
# 둘 다 비워 두면 AI 만들기만 꺼짐. 키는 팀 채널로만 공유
# Cloudflare 대시보드 → Account ID, API 토큰(Workers AI 권한)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Google AI Studio (이미지 모델은 결제 설정이 있어야 동작)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
